# Optional: Gemini API key for higher-quality AI story/script/scene generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional public/base URL used by hosted deployments.
APP_URL="http://localhost:3000"

# Optional absolute path to ffmpeg.exe. Leave blank if ffmpeg is on PATH.
FFMPEG_PATH=""

# Backend port for the local production engine.
PORT=3001
